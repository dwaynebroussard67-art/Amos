# The current preview is static and does not read these values.
# Keep PAYMENT_MODE=demo until the business owner supplies his own payment account.
APP_MODE=demo
PAYMENT_MODE=demo
PUBLIC_SITE_URL=http://localhost:4173

# Add the owner's Stripe test keys only when a real backend is connected.
# Never put STRIPE_SECRET_KEY in browser code or index.html.
STRIPE_PUBLISHABLE_KEY=pk_test_replace_with_owner_key
STRIPE_SECRET_KEY=sk_test_replace_with_owner_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_owner_secret

# Optional production handoff values.
BUSINESS_EMAIL=owner@example.com
